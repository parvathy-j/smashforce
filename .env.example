# Stripe server secret key
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe webhook signing secret (from Stripe Dashboard webhook endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Public key used by booking.html (keep as publishable key)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional app URL for success/cancel redirects
APP_URL=https://www.smashforcebadminton.com

# Optional CMS/public frontend URL. When set, GET / redirects there instead of
# serving smash-force-academy.html from this Node service.
# CMS_SERVING_URL=https://www.smashforcebadminton.com

# Use production mode and HTTPS URL in deployment
# NODE_ENV=production
# APP_URL=https://www.smashforcebadminton.com

# If running behind Render/Railway/Nginx/Cloudflare proxy, enable trust proxy
# TRUST_PROXY=1

# Cookie hardening options
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_DOMAIN=.your-domain.com

# Server port
PORT=3000

# Database provider: sqlite (default) or postgres
# DB_PROVIDER=sqlite

# PostgreSQL connection (required when DB_PROVIDER=postgres)
# DATABASE_URL=postgres://username:password@localhost:5432/smashforce

# Optional booking promo codes as JSON.
# type: "percent" value in %, or type: "fixed" value in cents.
# minAmount is optional and in cents.
# PROMO_CODES={"WELCOME10":{"type":"percent","value":10},"SAVE500":{"type":"fixed","value":500,"minAmount":2000}}

# Secret token required to grant admin role via POST /admin/make-admin
# Set to a long random string and keep private
ADMIN_SECRET=change_me_to_a_long_random_string
